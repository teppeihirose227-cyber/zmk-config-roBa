/*
 * roBa keymap  ― Mac / iPad を「JIS配列」として使う前提
 *
 * ZMK のキー名は US 配列基準なので、JIS で目的の文字を出すために
 * 下の JP_* マクロで読み替えている。Studio の表示（US 名）と実際の文字は食い違う。
 *
 * レイヤー構成
 *   0 BASE  : 基本（執筆用）
 *   1 NAV   : 右親指・内側を押している間 … Esc / 矢印（逆T字）/ デスクトップ操作
 *   2 NUM   : 右親指 Tab を長押し  … 数字（上段 1〜0）/ 記号 / BT 切替
 *   3 MOUSE : トラックボールを動かすと自動で入る
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* ---- JIS 配列で出したい文字 → 送るキーコード ---- */
#define JP_LBKT   RBKT              /* [  */
#define JP_RBKT   NON_US_HASH       /* ]  */
#define JP_LBRC   LS(RBKT)          /* {  */
#define JP_RBRC   LS(NON_US_HASH)   /* }  */
#define JP_AT     LBKT              /* @  */
#define JP_GRV    LS(LBKT)          /* `  */
#define JP_COLN   SQT               /* :  */
#define JP_ASTR   LS(SQT)           /* *  */
#define JP_SCLN   SEMI              /* ;  */
#define JP_PLUS   LS(SEMI)          /* +  */
#define JP_CIRC   EQUAL             /* ^  */
#define JP_TILD   LS(EQUAL)         /* ~  */
#define JP_EQL    LS(MINUS)         /* =  */
#define JP_YEN    INT_YEN           /* ¥  */
#define JP_PIPE   LS(INT_YEN)       /* |  */
#define JP_BSLS   LA(INT_YEN)       /* \  (Mac: Option+¥) */
#define JP_UNDS   LS(INT_RO)        /* _  */
#define JP_DQUO   LS(N2)            /* "  */
#define JP_QUOT   LS(N7)            /* '  */
#define JP_LPRN   LS(N8)            /* (  */
#define JP_RPRN   LS(N9)            /* )  */

#define BASE  0
#define NAV   1
#define NUM   2
#define MOUSE 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <MOUSE>;
};

/* エンコーダ1回転あたりのスクロール回数（元は10。少ないほど控えめ） */
&sensors {
    triggers-per-rotation = <4>;
};

/* エンコーダ用：一定速度でスクロール（加速なし） */
&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        /*
         * エンコーダ1目盛り＝マウスホイール約1ノッチ。
         * 速度80/秒で25ms押す → 16ms周期の1回分（80×16/1000≒1）だけスクロールする。
         * Mac の「ナチュラルなスクロール」オンで、時計回り＝以前の↑キーと同じ動き。
         */
        scroll_enc: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-80)>, <&msc MOVE_Y(80)>;
            tap-ms = <25>;
        };

        /*
         * 横スクロール版（NAV を押さえている間）。Scrivener の縦書き用。
         * 縦スクロールで「下へ進む」のと同じ回し方で、縦書きの原稿を読み進める（画面は左へ）。
         */
        scroll_enc_h: scroll_encoder_horizontal {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(-80)>, <&msc MOVE_X(80)>;
            tap-ms = <25>;
        };

        mt_ime: mt_ime {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                                     &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &kp LS(LG(S))       &kp JP_LBKT    &kp H  &kp J  &kp K  &kp L  &kp DOT
&kp Z  &kp X  &kp C  &kp V  &kp B  &kp LC(SPACE)       &kp JP_RBKT    &kp N  &kp M  &kp MINUS  &kp QMARK  &kp COMMA
&kp LCTRL  &kp LALT  &kp LGUI  &mt_ime LSHIFT SPACE  &kp ENTER  &kp BSPC  &lt NUM TAB  &mo NAV  &kp JP_COLN
            >;
            sensor-bindings = <&scroll_enc>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp ESC  &trans         &kp UP      &trans          &trans                  &trans  &trans  &trans  &trans  &trans
&trans   &kp LEFT       &kp DOWN    &kp RIGHT       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp LC(LEFT)   &kp LC(UP)  &kp LC(RIGHT)   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
            >;
            sensor-bindings = <&scroll_enc_h>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp N1     &kp N2      &kp N3       &kp N4       &kp N5                                    &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
&kp MINUS  &kp JP_EQL  &kp JP_LBKT  &kp JP_RBKT  &kp JP_BSLS  &trans         &kp JP_LPRN  &kp JP_QUOT  &kp JP_DQUO  &kp JP_SCLN  &kp SLASH    &kp JP_GRV
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans          &kp JP_RPRN  &kp JP_TILD  &kp JP_PIPE  &kp JP_AT    &kp JP_CIRC  &kp JP_UNDS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans    &trans    &trans                    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans  &mkp MB5  &trans    &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &mkp MB4  &mkp MB5  &trans  &trans  &trans    &trans    &mkp MB4  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
